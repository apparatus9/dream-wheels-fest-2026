rules_version = '2';

// ============================================================================
// Dream Wheels on Eglinton Fest 2026 — Firestore security rules
//
// PASTE THIS into Firebase console > Firestore Database > Rules > Publish.
//
// The shape of this is deliberate:
//   - Anyone can CREATE an entry (that's the public form doing its job).
//   - Only the signed-in OWNER can READ (the phone dashboard signs in as them).
//   - NOBODY can UPDATE or DELETE from the web.
//
// That last part matters: your entrants' names, emails and phone numbers live
// in this collection. Read is limited to the single owner account, so even
// though the project's apiKey is visible in the deployed page, nobody else can
// pull your entry list. The admin dashboard (admin.html) signs in as the owner
// to read; draw.js reads via the service account key.
//
// DO NOT switch this to "test mode" (allow read, write: if true). Test mode
// would let anyone on the internet download every entrant's contact details.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions must live inside a match block — not at file top level.
    function hasExpectedShape(d) {
      return d.keys().hasAll([
               'ticket', 'timestamp', 'first', 'last', 'email', 'phone',
               'car', 'intent', 'followed', 'tickets', 'age18',
               'consent', 'sms', 'event'
             ])
             && d.size() <= 17;
    }

    function hasValidText(d) {
      return d.first     is string && d.first.size()     > 0 && d.first.size()     <= 60
          && d.last      is string && d.last.size()      > 0 && d.last.size()      <= 60
          && d.email     is string && d.email.size()     > 3 && d.email.size()     <= 200
          && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[a-zA-Z]{2,}$')
          && d.car       is string && d.car.size()       > 0 && d.car.size()       <= 120
          && d.ticket    is string && d.ticket.size()    > 0 && d.ticket.size()    <= 20
          && d.phone     is string && d.phone.size()     <= 40
          && d.intent    is string && d.intent.size()    > 0 && d.intent.size()    <= 60;
    }

    function hasValidConsent(d) {
      return d.followed in ['Yes', 'No']
          // bonus ticket for following: 2 if followed, else 1. Enforce the
          // link so nobody can hand themselves extra tickets by editing the payload.
          && d.tickets == (d.followed == 'Yes' ? '2' : '1')
          // marketing consents are optional by design (CASL: consent must be
          // freely given) — we only require that the recorded value is honest
          && d.consent in ['Yes', 'No']
          && d.sms     in ['Yes', 'No']
          // eligibility enforced at write time, not just in the UI
          && d.age18 == 'Yes';
    }

    // The single owner account allowed to read entries (the phone dashboard).
    function isOwner() {
      return request.auth != null
          && request.auth.uid == 'BnM8Ji9rI6XekSL1u5DwYwOYpmv1';
    }

    match /entries/{entryId} {
      allow create: if hasExpectedShape(request.resource.data)
                    && hasValidText(request.resource.data)
                    && hasValidConsent(request.resource.data);

      // Only the owner can read; nobody can edit or delete from the web.
      allow read: if isOwner();
      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
